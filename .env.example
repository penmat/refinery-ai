REFINERY_MODEL=openai:gpt-5-mini
REFINERY_LITELLM_MODEL=ollama_chat/llama3.1:8b
REFINERY_LITELLM_API_BASE=http://localhost:11434
REFINERY_MAX_REPAIR_ATTEMPTS=3
REFINERY_COMMAND_TIMEOUT_SECONDS=900
REFINERY_GRAPHIFY_TIMEOUT_SECONDS=900
REFINERY_ALLOW_DIRTY_WORKTREE=false
REFINERY_DEPENDENCY_ANALYSIS_ENABLED=true
REFINERY_DEPENDENCY_RESOLUTION_TIMEOUT_SECONDS=900
REFINERY_MAVEN_DEPENDENCY_PLUGIN_VERSION=3.11.0
REFINERY_OSV_API_URL=https://api.osv.dev
REFINERY_OSV_TIMEOUT_SECONDS=30
REFINERY_OSV_VERIFY_SSL=true
REFINERY_SONARQUBE_ENABLED=true
REFINERY_SONARQUBE_IMAGE=sonarqube:26.8.0.126808-community
REFINERY_SONARQUBE_IMAGE_PULL_TIMEOUT_SECONDS=1800
REFINERY_SONARQUBE_STARTUP_TIMEOUT_SECONDS=180
REFINERY_SONARQUBE_ANALYSIS_TIMEOUT_SECONDS=900
REFINERY_SONARQUBE_GRADLE_SCANNER_VERSION=7.2.2.6593
