OPENAI_API_KEY=

# The planner model is used for planning and documentation. It can be a less
# capable model than is used for code repair.
# gpt-5.6-terra works well
# gpt-5.6-luna is 10x less expensive
REFINERY_PLANNER_MODEL=openai:gpt-5.6-luna

# The repair model is used by the Pydantic AI repair agent. Context is generally
# small, so this can be a more capable model.
REFINERY_REPAIR_MODEL=openai:gpt-5.6-terra

# To switch back to Ollama, comment out the OpenAI model settings above and uncomment these:
# REFINERY_PLANNER_MODEL=ollama:gemma4:latest
# REFINERY_REPAIR_MODEL=ollama:gemma4:latest
# REFINERY_OLLAMA_BASE_URL=http://localhost:11434
REFINERY_MAX_REPAIR_ATTEMPTS=3
REFINERY_COMMAND_TIMEOUT_SECONDS=900
REFINERY_CODEGRAPH_TIMEOUT_SECONDS=900
REFINERY_ALLOW_DIRTY_WORKTREE=false
REFINERY_DEPENDENCY_ANALYSIS_ENABLED=true
REFINERY_DEPENDENCY_RESOLUTION_TIMEOUT_SECONDS=900
REFINERY_MAVEN_DEPENDENCY_PLUGIN_VERSION=3.11.0
REFINERY_OSV_API_URL=https://api.osv.dev
REFINERY_OSV_TIMEOUT_SECONDS=30
REFINERY_OSV_VERIFY_SSL=true
REFINERY_SONARQUBE_ENABLED=true
REFINERY_SONARQUBE_IMAGE=sonarqube:26.8.0.126808-community
REFINERY_SONARQUBE_IMAGE_PULL_TIMEOUT_SECONDS=1800
REFINERY_SONARQUBE_STARTUP_TIMEOUT_SECONDS=180
REFINERY_SONARQUBE_ANALYSIS_TIMEOUT_SECONDS=900
REFINERY_SONARQUBE_GRADLE_SCANNER_VERSION=7.2.2.6593
